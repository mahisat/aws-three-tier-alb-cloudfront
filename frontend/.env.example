# Local dev: Vite proxies /api → http://localhost:5000 (see vite.config.ts)
VITE_API_BASE_URL=/api

# Optional — local backend without proxy:
# VITE_API_BASE_URL=http://localhost:5000/api

# Production (S3 + CloudFront): build with /api so the browser calls the same host;
# CloudFront forwards /api/* to the ALB (see .github/workflows/frontend-deployment.yml).
# VITE_API_BASE_URL=/api
